# =============================================================
# 环境变量示例
# 复制为 .env 后填入真实值：  cp .env.example .env
# =============================================================

# 站点域名（构建时注入 canonical / sitemap / OG 绝对地址）
# 本地开发可以留空，生产必须填写真实域名，且不要带结尾斜杠
SITE_URL=https://cloudways-guide.com

# -------------------------------------------------------------
# Cloudways 联盟推广 ID（最重要的一项）
# -------------------------------------------------------------
# 全站所有推广链接都由 src/consts.ts 的 affiliateUrl() 统一生成，
# 最终形如： https://www.cloudways.com/en/?id=<你的ID>
# 换 ID 时只需改这一处，无需逐篇修改 Markdown。
#
# 当前生效值：1379004（已写入 .env）
# 部署时在平台面板配置同名环境变量即可覆盖，无需改动代码。
PUBLIC_CLOUDWAYS_AFFILIATE_ID=1379004
