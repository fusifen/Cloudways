---
import { affiliateUrl, CLOUDWAYS, NAV_LINKS, SITE } from '../consts';
import Icon from './Icon.astro';

const pathname = Astro.url.pathname;

// 顶部转化按钮链接统一由 affiliateUrl() 生成，自动带上推广 ID
const signupUrl = affiliateUrl(CLOUDWAYS.signup);

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href.replace(/\/$/, ''));
}
---

<header class="sticky top-0 z-50 border-b border-line bg-white/85 backdrop-blur-md">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <!-- Logo -->
    <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label={`${SITE.name} 首页`}>
      <span
        class="grid h-9 w-9 place-items-center rounded-[10px] bg-gradient-to-br from-brand-500 to-brand-700 text-white shadow-sm"
      >
        <Icon name="bolt" size={18} strokeWidth={2} />
      </span>
      <span class="flex flex-col leading-none">
        <span class="text-[15px] font-bold tracking-tight text-ink-900">Cloudways</span>
        <span class="text-[11px] font-medium tracking-wide text-ink-400">中文指南</span>
      </span>
    </a>

    <!-- 桌面导航 -->
    <nav class="hidden items-center gap-1 lg:flex" aria-label="主导航">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class:list={[
              'rounded-lg px-3 py-2 text-sm font-medium transition-colors',
              isActive(link.href)
                ? 'bg-brand-50 text-brand-700'
                : 'text-ink-600 hover:bg-surface-2 hover:text-ink-900',
            ]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- 右侧操作区 -->
    <div class="flex items-center gap-2">
      <a
        href="/articles/"
        class="hidden h-9 w-9 place-items-center rounded-lg text-ink-500 transition-colors hover:bg-surface-2 hover:text-ink-900 sm:grid"
        aria-label="搜索文章"
      >
        <Icon name="search" size={18} />
      </a>

      <a
        href={signupUrl}
        class="btn btn-cta hidden sm:inline-flex"
        target="_blank"
        rel="sponsored nofollow noopener"
        data-affiliate="cloudways"
      >
        免费试用
        <Icon name="arrowUpRight" size={15} />
      </a>

      <!-- 移动端菜单按钮 -->
      <button
        type="button"
        id="nav-toggle"
        class="grid h-9 w-9 place-items-center rounded-lg text-ink-700 transition-colors hover:bg-surface-2 lg:hidden"
        aria-label="打开菜单"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <Icon name="menu" size={20} class="nav-icon-open" />
        <Icon name="close" size={20} class="nav-icon-close hidden" />
      </button>
    </div>
  </div>

  <!-- 移动端抽屉 -->
  <div id="mobile-nav" class="hidden border-t border-line bg-white lg:hidden">
    <nav class="container-page flex flex-col py-3" aria-label="移动端导航">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class:list={[
              'rounded-lg px-3 py-2.5 text-[15px] font-medium',
              isActive(link.href) ? 'bg-brand-50 text-brand-700' : 'text-ink-700',
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={signupUrl}
        class="btn btn-cta mt-2"
        target="_blank"
        rel="sponsored nofollow noopener"
        data-affiliate="cloudways"
      >
        免费试用 Cloudways
        <Icon name="arrowUpRight" size={15} />
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('mobile-nav');
  const iconOpen = toggle?.querySelector('.nav-icon-open');
  const iconClose = toggle?.querySelector('.nav-icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    iconOpen?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
  });
</script>
