---
/**
 * 侧边栏粘性转化卡片（桌面端）
 */
import { TRUST_POINTS } from '../consts';
import AffiliateButton from './AffiliateButton.astro';
import Icon from './Icon.astro';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  label?: string;
  class?: string;
}

const {
  title = '推荐方案',
  description = 'DigitalOcean 2GB 档：28 美元/月，1 vCPU / 2GB 内存 / 50GB SSD，适合中小企业站与 WooCommerce 起步。',
  path = '/en/cloud-hosting-signup.php',
  label = '免费试用 Cloudways',
  class: className = '',
} = Astro.props;
---

<div class:list={['card overflow-hidden', className]}>
  <div class="bg-gradient-to-br from-brand-600 to-brand-700 px-5 py-4 text-white">
    <h3 class="flex items-center gap-2 text-[15px] font-bold text-white">
      <Icon name="sparkles" size={16} />
      {title}
    </h3>
  </div>
  <div class="p-5">
    <p class="text-[13px] leading-relaxed text-ink-600">{description}</p>
    <ul class="mt-4 space-y-2">
      {
        TRUST_POINTS.map((point) => (
          <li class="flex items-start gap-2 text-[13px] text-ink-600">
            <Icon name="check" size={14} class="mt-0.5 shrink-0 text-accent-600" />
            {point}
          </li>
        ))
      }
    </ul>
    <AffiliateButton path={path} label={label} variant="cta" block class="mt-5" />
    <p class="mt-3 text-center text-[11px] text-ink-400">无需信用卡 · 随时可取消</p>
  </div>
</div>
