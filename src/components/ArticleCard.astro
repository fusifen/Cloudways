---
import { CATEGORIES, type CategoryKey } from '../consts';
import { formatDate, readingTimeOf, type Article } from '../lib/articles';
import Icon from './Icon.astro';

interface Props {
  article: Article;
  /** 首篇可放大展示 */
  featured?: boolean;
  class?: string;
}

const { article, featured = false, class: className = '' } = Astro.props;
const d = article.data;
const cat = CATEGORIES[d.category as CategoryKey];
const minutes = readingTimeOf(article);
const href = `/articles/${article.id}/`;
---

<article
  class:list={['card group flex flex-col overflow-hidden transition-shadow hover:shadow-lift', className]}
>
  <a href={href} class="flex h-full flex-col" aria-label={d.title}>
    {
      d.heroImage && (
        <div class:list={['relative overflow-hidden bg-surface-2', featured ? 'h-52' : 'h-40']}>
          <img
            src={d.heroImage}
            alt={d.heroImageAlt || d.title}
            width="1200"
            height="630"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
          />
        </div>
      )
    }

    <div class="flex flex-1 flex-col p-5">
      <div class="flex flex-wrap items-center gap-2">
        <span class="chip" style={`background:${cat?.color}14;color:${cat?.color}`}>
          {cat?.label ?? d.category}
        </span>
        {d.featured && (
          <span class="chip bg-amber-100 text-amber-700">
            <Icon name="sparkles" size={12} />
            精选
          </span>
        )}
      </div>

      <h3
        class:list={[
          'mt-3 font-bold leading-snug text-ink-900 transition-colors group-hover:text-brand-700',
          featured ? 'text-xl' : 'text-[17px]',
        ]}
      >
        {d.title}
      </h3>

      <p class="mt-2.5 line-clamp-3 flex-1 text-sm leading-relaxed text-ink-500">{d.description}</p>

      <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs text-ink-400">
        <span class="inline-flex items-center gap-1.5">
          <Icon name="calendar" size={13} />
          <time datetime={d.pubDate.toISOString()}>{formatDate(d.pubDate)}</time>
        </span>
        <span class="inline-flex items-center gap-1.5">
          <Icon name="clock" size={13} />
          {minutes} 分钟
        </span>
        <span class="inline-flex items-center gap-1.5 text-brand-600">
          <Icon name="arrowRight" size={13} />
          阅读全文
        </span>
      </div>
    </div>
  </a>
</article>
