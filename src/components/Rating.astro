---
import Icon from './Icon.astro';

interface Props {
  value: number;
  showValue?: boolean;
  size?: number;
  class?: string;
}

const { value, showValue = true, size = 15, class: className = '' } = Astro.props;
const full = Math.floor(value);
const hasHalf = value - full >= 0.5;
const empty = 5 - full - (hasHalf ? 1 : 0);
---

<div class:list={['flex items-center gap-1', className]} aria-label={`评分 ${value} 分，满分 5 分`}>
  {
    Array.from({ length: full }).map(() => (
      <Icon name="star" size={size} class="fill-amber-400 text-amber-400" strokeWidth={1} />
    ))
  }
  {
    hasHalf && (
      <span class="relative inline-flex" style={`width:${size}px;height:${size}px`}>
        <Icon name="star" size={size} class="absolute inset-0 text-amber-400" strokeWidth={1} />
        <span class="absolute inset-0 overflow-hidden" style="width:50%">
          <Icon
            name="star"
            size={size}
            class="fill-amber-400 text-amber-400"
            strokeWidth={1}
          />
        </span>
      </span>
    )
  }
  {
    Array.from({ length: Math.max(0, empty) }).map(() => (
      <Icon name="star" size={size} class="text-ink-400/50" strokeWidth={1} />
    ))
  }
  {showValue && <span class="ml-1 text-sm font-semibold text-ink-700">{value.toFixed(1)}</span>}
</div>
