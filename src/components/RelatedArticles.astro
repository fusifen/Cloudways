---
import type { Article } from '../lib/articles';
import ArticleCard from './ArticleCard.astro';
import Icon from './Icon.astro';

interface Props {
  articles: Article[];
  title?: string;
  class?: string;
}

const { articles, title = '相关阅读', class: className = '' } = Astro.props;
---

{
  articles.length > 0 && (
    <section class:list={['mt-14', className]} aria-labelledby="related-heading">
      <h2 id="related-heading" class="flex items-center gap-2.5 text-xl font-bold">
        <span class="grid h-8 w-8 place-items-center rounded-lg bg-brand-50 text-brand-600">
          <Icon name="bookOpen" size={17} />
        </span>
        {title}
      </h2>
      <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {articles.map((article) => (
          <ArticleCard article={article} />
        ))}
      </div>
    </section>
  )
}
