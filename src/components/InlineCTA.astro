---
/**
 * 文章内嵌转化卡片 —— 用于正文中部
 */
import { TRUST_POINTS } from '../consts';
import AffiliateButton from './AffiliateButton.astro';
import Icon from './Icon.astro';

interface Props {
  title?: string;
  description?: string;
  label?: string;
  class?: string;
}

const {
  title = '想直接上手试试？',
  description = 'Cloudways 支持无需信用卡免费试用，5 家底层云厂商任选，开启 Breeze 缓存后 TTFB 可降 70% 以上。',
  label = '免费试用 Cloudways',
  class: className = '',
} = Astro.props;
---

<aside
  class:list={[
    'my-8 overflow-hidden rounded-2xl border border-brand-200 bg-gradient-to-br from-brand-50 to-white p-5 sm:p-6',
    className,
  ]}
>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div class="min-w-0">
      <h3 class="flex items-center gap-2 text-base font-bold text-ink-900">
        <span class="grid h-7 w-7 place-items-center rounded-lg bg-brand-600 text-white">
          <Icon name="sparkles" size={15} />
        </span>
        {title}
      </h3>
      <p class="mt-2 text-sm leading-relaxed text-ink-600">{description}</p>
      <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1.5">
        {
          TRUST_POINTS.map((point) => (
            <li class="inline-flex items-center gap-1.5 text-[12.5px] text-ink-500">
              <Icon name="check" size={13} class="text-accent-600" />
              {point}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="shrink-0">
      <AffiliateButton label={label} variant="cta" size="lg" class="w-full sm:w-auto" />
    </div>
  </div>
</aside>
