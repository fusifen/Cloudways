---
/**
 * 文章目录（TOC）
 * 由 Astro 的 headings 生成，带滚动高亮
 */
import type { MarkdownHeading } from 'astro';
import Icon from './Icon.astro';

interface Props {
  headings: MarkdownHeading[];
  minLevel?: number;
  maxLevel?: number;
}

const { headings, minLevel = 2, maxLevel = 3 } = Astro.props;

const items = headings.filter((h) => h.depth >= minLevel && h.depth <= maxLevel);

// 生成嵌套结构（h2 下挂 h3）
const tree: { heading: MarkdownHeading; children: MarkdownHeading[] }[] = [];
for (const h of items) {
  if (h.depth === minLevel) {
    tree.push({ heading: h, children: [] });
  } else if (tree.length) {
    tree[tree.length - 1].children.push(h);
  }
}
---

{
  items.length > 2 && (
    <nav aria-labelledby="toc-title" class="text-sm">
      <h2
        id="toc-title"
        class="flex items-center gap-2 text-[13px] font-bold uppercase tracking-wide text-ink-500"
      >
        <Icon name="bookOpen" size={15} class="text-brand-600" />
        本文目录
      </h2>
      <ul class="mt-3.5 space-y-1 border-l border-line" data-toc>
        {tree.map((node) => (
          <li>
            <a
              href={`#${node.heading.slug}`}
              class="toc-link -ml-px block border-l-2 border-transparent py-1.5 pl-3.5 text-[13px] leading-snug text-ink-500 transition-colors hover:border-brand-300 hover:text-brand-700"
              data-target={node.heading.slug}
            >
              {node.heading.text}
            </a>
            {node.children.length > 0 && (
              <ul class="space-y-0.5">
                {node.children.map((child) => (
                  <li>
                    <a
                      href={`#${child.slug}`}
                      class="toc-link -ml-px block border-l-2 border-transparent py-1 pl-7 text-[12.5px] leading-snug text-ink-400 transition-colors hover:border-brand-300 hover:text-brand-700"
                      data-target={child.slug}
                    >
                      {child.text}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .toc-link.is-active {
    border-left-color: var(--color-brand-500);
    color: var(--color-brand-700);
    font-weight: 600;
  }
</style>

<script>
  const links = Array.from(document.querySelectorAll('.toc-link'));
  if (links.length) {
    const targets = links
      .map((l) => document.getElementById(l.getAttribute('data-target') || ''))
      .filter((el): el is HTMLElement => Boolean(el));

    const onScroll = () => {
      let activeId = '';
      for (const el of targets) {
        if (el.getBoundingClientRect().top <= 120) activeId = el.id;
      }
      links.forEach((l) => {
        l.classList.toggle('is-active', l.getAttribute('data-target') === activeId);
      });
    };

    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
