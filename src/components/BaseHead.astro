---
/**
 * BaseHead —— 全站 SEO 头部
 * 统一输出：title / description / canonical / Open Graph / Twitter Card /
 * robots / hreflang / RSS / JSON-LD 结构化数据
 */
import { SITE, ogImagePath } from '../consts';
import { jsonLd } from '../lib/schema';

interface Props {
  title?: string;
  description?: string;
  /** 相对路径，如 /articles/foo/ */
  path: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'product';
  keywords?: string[];
  noindex?: boolean;
  /** 额外的 JSON-LD 对象数组 */
  schemas?: unknown[];
  publishedTime?: string;
  modifiedTime?: string;
  locale?: string;
}

const {
  title,
  description = SITE.description,
  path,
  ogImage = SITE.defaultOgImage,
  ogType = 'website',
  keywords = [],
  noindex = false,
  schemas = [],
  publishedTime,
  modifiedTime,
  locale = SITE.locale,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE.titleSuffix}` : `${SITE.name} — 托管云主机评测与教程`;
const canonical = new URL(path, SITE.url).toString();
// 社交平台不渲染 SVG，统一转成同名 PNG
const ogImageAbs = new URL(ogImagePath(ogImage), SITE.url).toString();
const rssUrl = new URL('/rss.xml', SITE.url).toString();
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{pageTitle}</title>
<meta name="description" content={description} />
{keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
<link rel="canonical" href={canonical} />

<!-- 多语言结构预留 -->
<link rel="alternate" hreflang="zh-CN" href={canonical} />
<link rel="alternate" hreflang="x-default" href={canonical} />

<!-- 索引控制 -->
{
  noindex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
  )
}

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content="zh_CN" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageAbs} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SITE.twitter} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageAbs} />

<!-- 订阅与图标 -->
<link rel="alternate" type="application/rss+xml" title={`${SITE.name} RSS`} href={rssUrl} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="180x180" href="/favicon.png" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<!-- iOS 添加到主屏幕的图标不支持 SVG，必须用 PNG -->
<link rel="apple-touch-icon" sizes="180x180" href="/favicon.png" />
<meta name="theme-color" content="#2563eb" />
<meta name="format-detection" content="telephone=no" />

<!-- JSON-LD 结构化数据 -->
{schemas.filter(Boolean).map((schema) => <script type="application/ld+json" set:html={jsonLd(schema)} />)}
