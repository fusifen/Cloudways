---
import ArticleIndex from '../../../../components/ArticleIndex.astro';
import { CATEGORIES, CATEGORY_KEYS, isCategoryKey, type CategoryKey } from '../../../../consts';
import {
  countByCategory,
  filterByCategory,
  getPublishedArticles,
  paginateItems,
  totalPagesFor,
} from '../../../../lib/articles';

export async function getStaticPaths() {
  const all = await getPublishedArticles();
  const paths: { params: { category: string; page: string } }[] = [];

  for (const key of CATEGORY_KEYS) {
    const total = totalPagesFor(filterByCategory(all, key).length);
    for (let p = 2; p <= total; p++) {
      paths.push({ params: { category: key, page: String(p) } });
    }
  }

  return paths;
}

const categoryKey = Astro.params.category as string;
const category: CategoryKey = isCategoryKey(categoryKey) ? categoryKey : 'tutorial';
const cat = CATEGORIES[category];
const currentPage = Number(Astro.params.page);

const all = await getPublishedArticles();
const filtered = filterByCategory(all, category);
const { items, totalPages } = paginateItems(filtered, currentPage);
const counts = countByCategory(all);

const crumbs = [
  { label: '首页', href: '/' },
  { label: '文章教程', href: '/articles/' },
  { label: cat.label, href: `/categories/${category}/` },
  { label: `第 ${currentPage} 页` },
];
---

<ArticleIndex
  title={`Cloudways ${cat.label} — 第 ${currentPage} 页`}
  description={`${cat.description}。当前分类共 ${filtered.length} 篇文章，这是第 ${currentPage} 页。`}
  path={`/categories/${category}/page/${currentPage}/`}
  items={items}
  allArticles={all}
  total={filtered.length}
  currentPage={currentPage}
  totalPages={totalPages}
  baseUrl={`/categories/${category}/`}
  activeCategory={category}
  crumbs={crumbs}
  counts={counts}
/>
