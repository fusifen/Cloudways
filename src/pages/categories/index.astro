---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import { CATEGORIES, CATEGORY_KEYS } from '../../consts';
import { countByCategory, getPublishedArticles } from '../../lib/articles';
import { breadcrumbSchema } from '../../lib/schema';

const all = await getPublishedArticles();
const counts = countByCategory(all);
const crumbs = [{ label: '首页', href: '/' }, { label: '全部分类' }];
---

<BaseLayout
  title="文章分类"
  description={`Cloudways 中文内容库的六个内容方向：${CATEGORY_KEYS.map((k) => CATEGORIES[k].label).join('、')}。共 ${all.length} 篇文章。`}
  path="/categories/"
  schemas={[breadcrumbSchema(crumbs)]}
  width="default"
>
  <Breadcrumbs items={crumbs} />

  <header class="mt-6 max-w-3xl">
    <h1 class="text-3xl font-bold tracking-tight sm:text-[2.4rem]">文章分类</h1>
    <p class="mt-4 text-[17px] leading-relaxed text-ink-500">
      六个内容方向，覆盖从「第一次用」到「长期运维」的完整路径。
    </p>
  </header>

  <div class="mt-10 grid gap-5 sm:grid-cols-2">
    {
      CATEGORY_KEYS.map((key) => {
        const cat = CATEGORIES[key];
        const recent = all.filter((a) => a.data.category === key).slice(0, 3);
        return (
          <section class="card flex flex-col p-6">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h2 class="flex items-center gap-2.5 text-lg font-bold">
                  <span
                    class="h-3 w-3 rounded-full"
                    style={`background:${cat.color}`}
                    aria-hidden="true"
                  />
                  {cat.label}
                </h2>
                <p class="mt-2 text-[14px] leading-relaxed text-ink-500">{cat.description}</p>
              </div>
              <span
                class="chip shrink-0"
                style={`background:${cat.color}14;color:${cat.color}`}
              >
                {counts[key] ?? 0} 篇
              </span>
            </div>

            {recent.length > 0 && (
              <ul class="mt-4 space-y-2 border-t border-line pt-4">
                {recent.map((a) => (
                  <li>
                    <a
                      href={`/articles/${a.id}/`}
                      class="flex items-start gap-2 text-[13.5px] leading-snug text-ink-600 transition-colors hover:text-brand-600"
                    >
                      <Icon name="chevronRight" size={13} class="mt-1 shrink-0 text-ink-400" />
                      <span class="line-clamp-2">{a.data.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}

            <a
              href={`/categories/${key}/`}
              class="mt-5 inline-flex items-center gap-1.5 text-[13.5px] font-semibold text-brand-600 hover:text-brand-700"
            >
              查看全部 {cat.label}
              <Icon name="arrowRight" size={14} />
            </a>
          </section>
        );
      })
    }
  </div>
</BaseLayout>
