---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ProductComparisonTable from '../components/ProductComparisonTable.astro';
import AffiliateButton from '../components/AffiliateButton.astro';
import Icon from '../components/Icon.astro';
import { PROVIDERS, type ProviderKey } from '../consts';
import { formatPrice, getSortedProducts } from '../lib/articles';
import { breadcrumbSchema } from '../lib/schema';

const products = await getSortedProducts();
const crumbs = [{ label: '首页', href: '/' }, { label: '厂商对比' }];

// 厂商维度横向对比矩阵
const cheapestOf = (p: (typeof products)[number]) =>
  [...p.data.plans].sort((a, b) => a.monthlyPrice - b.monthlyPrice)[0];

const matrix = [
  {
    label: '起步月费',
    get: (p: (typeof products)[number]) => formatPrice(cheapestOf(p).monthlyPrice, 0),
  },
  {
    label: '起步内存',
    get: (p: (typeof products)[number]) => `${cheapestOf(p).ram} GB`,
  },
  {
    label: '最高内存档',
    get: (p: (typeof products)[number]) =>
      `${Math.max(...p.data.plans.map((x) => x.ram))} GB`,
  },
  {
    label: '配置档位数',
    get: (p: (typeof products)[number]) => `${p.data.plans.length} 个`,
  },
  {
    label: '可选机房',
    get: (p: (typeof products)[number]) => `${p.data.datacenters.length} 个`,
  },
  {
    label: '亚太机房',
    get: (p: (typeof products)[number]) => {
      const apac = p.data.datacenters.filter((dc) =>
        [
          '新加坡',
          '日本',
          '韩国',
          '印度',
          '澳大利亚',
          '中国',
        ].includes(dc.country),
      );
      return apac.length ? `${apac.length} 个` : '无';
    },
  },
  {
    label: '综合评分',
    get: (p: (typeof products)[number]) => p.data.rating.toFixed(1),
  },
];

const scenarios = [
  {
    icon: 'dollar',
    title: '预算优先 / 第一次用',
    pick: 'DigitalOcean',
    id: 'digitalocean',
    why: '14 美元起，流量包充足，机房覆盖亚太。综合性价比最高，适合 90% 的个人站长与中小团队。',
  },
  {
    icon: 'bolt',
    title: '后台卡顿 / 动态内容多',
    pick: 'Vultr 高频档',
    id: 'vultr',
    why: '高主频 CPU 加 NVMe 磁盘，单核性能突出。CPU 长期飙高而内存有余量时，这是比加内存更有效的解法。',
  },
  {
    icon: 'globe',
    title: '用户跨亚太与欧美',
    pick: 'Google Cloud',
    id: 'gcp',
    why: 'Premium Tier 骨干网让跨境访问的延迟抖动最小。对登录、结算、实时协作类场景收益明显。',
  },
  {
    icon: 'shieldCheck',
    title: '企业采购 / 合规要求',
    pick: 'Amazon AWS',
    id: 'aws',
    why: '可签署数据处理协议、支持数据驻留，全球区域最多。已有 AWS 生态的业务衔接成本最低。',
  },
  {
    icon: 'server',
    title: '面向欧美 / 长期稳定',
    pick: 'Linode (Akamai)',
    id: 'linode',
    why: '与 DigitalOcean 同价，Akamai 边缘网络加持，磁盘 IO 一致性好，适合部署完就不想再管的生产站。',
  },
];
---

<BaseLayout
  title="Cloudways 五家云厂商对比"
  description="DigitalOcean、AWS、Google Cloud、Linode、Vultr 五家底层云厂商的横向对比：起步价、机房覆盖、配置档位与适用场景，附按需求的选择建议。"
  path="/compare/"
  keywords={['Cloudways 对比', '云厂商对比', 'DigitalOcean vs Vultr', '托管云主机选型']}
  schemas={[breadcrumbSchema(crumbs)]}
  width="wide"
>
  <Breadcrumbs items={crumbs} />

  <header class="mt-6 max-w-3xl">
    <span class="chip border border-brand-200 bg-brand-50 text-brand-700">
      <Icon name="chart" size={13} />
      {products.length} 家厂商横向对比
    </span>
    <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-[2.4rem]">该选哪家云厂商</h1>
    <p class="mt-4 text-[17px] leading-relaxed text-ink-500">
      这是 Cloudways 用户面对的第一个决策，也是最影响成本与访问速度的一个。
      先说结论：<strong>大多数情况下选 DigitalOcean 不会错</strong>；
      但如果你的用户集中在东亚、或者站点是动态生成内容，Vultr 会带来可感知的差异。
    </p>
  </header>

  <!-- 需求 → 推荐 -->
  <section class="mt-10" aria-labelledby="scenario-heading">
    <h2 id="scenario-heading" class="text-2xl font-bold tracking-tight">按需求直接选</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        scenarios.map((s) => (
          <div class="card flex flex-col p-5">
            <span class="grid h-10 w-10 place-items-center rounded-xl bg-brand-50 text-brand-600">
              <Icon name={s.icon} size={19} />
            </span>
            <h3 class="mt-3.5 text-[15px] font-bold text-ink-900">{s.title}</h3>
            <p class="mt-2 flex-1 text-[13.5px] leading-relaxed text-ink-500">{s.why}</p>
            <div class="mt-4 flex items-center justify-between border-t border-line pt-3.5">
              <span class="text-[13px] font-bold text-brand-700">{s.pick}</span>
              <a
                href={`/products/${s.id}/`}
                class="inline-flex items-center gap-1 text-[12.5px] font-semibold text-ink-500 hover:text-brand-600"
              >
                查看详情
                <Icon name="arrowRight" size={13} />
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 厂商维度矩阵 -->
  <section class="mt-14" aria-labelledby="matrix-heading">
    <h2 id="matrix-heading" class="text-2xl font-bold tracking-tight">厂商维度对比</h2>
    <p class="mt-2 text-[15px] text-ink-500">按厂商维度看关键指标差异。</p>

    <div class="card mt-6 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full min-w-[780px] border-collapse text-sm">
          <thead>
            <tr class="border-b border-line bg-surface text-left text-[13px] text-ink-500">
              <th scope="col" class="sticky left-0 bg-surface px-4 py-3 font-semibold">指标</th>
              {
                products.map((p) => (
                  <th scope="col" class="px-4 py-3 font-semibold">
                    <a
                      href={`/products/${p.id}/`}
                      class="inline-flex items-center gap-2 hover:text-brand-700"
                    >
                      <span
                        class="h-2.5 w-2.5 rounded-full"
                        style={`background:${p.data.brandColor}`}
                        aria-hidden="true"
                      />
                      {p.data.name}
                    </a>
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              matrix.map((row) => (
                <tr class="border-b border-line/70 last:border-0 hover:bg-surface">
                  <th scope="row" class="px-4 py-3.5 text-left font-medium text-ink-700">
                    {row.label}
                  </th>
                  {products.map((p) => (
                    <td class="px-4 py-3.5 tabular-nums text-ink-700">{row.get(p)}</td>
                  ))}
                </tr>
              ))
            }
            <tr class="bg-surface">
              <th scope="row" class="px-4 py-4 text-left font-medium text-ink-700">
                操作
              </th>
              {
                products.map((p) => (
                  <td class="px-4 py-4">
                    <AffiliateButton
                      path={p.data.ctaPath}
                      label="部署"
                      variant="primary"
                      size="sm"
                      params={{ provider: p.data.provider }}
                    />
                  </td>
                ))
              }
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 全档位对比表 -->
  <section class="mt-14" aria-labelledby="table-heading">
    <h2 id="table-heading" class="text-2xl font-bold tracking-tight">全部档位价格对比</h2>
    <p class="mt-2 text-[15px] text-ink-500">
      按内存档位筛选、按月费排序，找到同配置下最便宜的方案。
    </p>
    <ProductComparisonTable products={products} class="mt-6" />
  </section>

  <!-- 价格差异解释 -->
  <section class="mt-14" aria-labelledby="price-heading">
    <h2 id="price-heading" class="text-2xl font-bold tracking-tight">
      为什么 AWS 和 GCP 贵两三倍
    </h2>
    <div class="mt-6 grid gap-5 lg:grid-cols-2">
      <div class="card p-6">
        <p class="text-[15px] leading-relaxed text-ink-600">
          这个价差不来自 Cloudways 的加价 —— 它在各家 IaaS 之上收取的管理费是统一的。
          差异完全来自底层厂商自身的定价策略：
        </p>
        <ul class="mt-4 space-y-3 text-[14.5px] text-ink-600">
          <li class="flex gap-2.5">
            <Icon name="check" size={16} class="mt-0.5 shrink-0 text-brand-500" />
            <span>
              <strong class="text-ink-900">DigitalOcean / Vultr / Linode</strong>
              面向开发者与中小企业，把流量、快照打包进固定月费，价格透明。
            </span>
          </li>
          <li class="flex gap-2.5">
            <Icon name="check" size={16} class="mt-0.5 shrink-0 text-brand-500" />
            <span>
              <strong class="text-ink-900">AWS / GCP</strong>
              面向企业采购，定价包含合规认证、SLA 承诺、全球区域冗余等企业级成本。
            </span>
          </li>
        </ul>
      </div>

      <div class="card p-6">
        <h3 class="text-[15px] font-bold text-ink-900">多花的钱买到什么</h3>
        <ul class="mt-4 space-y-3 text-[14.5px] text-ink-600">
          <li class="flex gap-2.5">
            <Icon name="shieldCheck" size={16} class="mt-0.5 shrink-0 text-accent-600" />
            可签署 DPA、满足数据驻留要求的法务确定性
          </li>
          <li class="flex gap-2.5">
            <Icon name="globe" size={16} class="mt-0.5 shrink-0 text-accent-600" />
            更密集的全球区域覆盖（AWS 12+ 可选区域）
          </li>
          <li class="flex gap-2.5">
            <Icon name="layers" size={16} class="mt-0.5 shrink-0 text-accent-600" />
            与 S3 / CloudFront / BigQuery 等生态的衔接能力
          </li>
          <li class="flex gap-2.5">
            <Icon name="trendingUp" size={16} class="mt-0.5 shrink-0 text-accent-600" />
            更成熟的弹性伸缩与多可用区容灾
          </li>
        </ul>
        <p class="mt-4 rounded-lg bg-surface px-3.5 py-2.5 text-[13px] leading-relaxed text-ink-500">
          如果这些都不是你的痛点，多花的钱就买不到对应的价值。
        </p>
      </div>
    </div>
  </section>

  <section class="mt-14 rounded-2xl border border-brand-200 bg-brand-50/60 p-6 sm:p-8">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-xl font-bold text-ink-900">用 20 美元自己做一次实测</h2>
        <p class="mt-2 max-w-2xl text-[14.5px] leading-relaxed text-ink-600">
          同时开三台同配置实例跑一周，用 WebPageTest 从你的目标地区各测 5 次，
          取中位数后保留最快的一台。按小时计费，成本约 20 美元以内。
        </p>
      </div>
      <AffiliateButton label="开始对比测试" variant="cta" size="lg" class="shrink-0" />
    </div>
  </section>
</BaseLayout>
