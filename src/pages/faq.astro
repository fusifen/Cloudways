---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FaqSection from '../components/FaqSection.astro';
import AffiliateButton from '../components/AffiliateButton.astro';
import Icon from '../components/Icon.astro';
import { CATEGORIES, CATEGORY_KEYS, type CategoryKey } from '../consts';
import { getPublishedArticles } from '../lib/articles';
import { breadcrumbSchema, faqSchema } from '../lib/schema';

const articles = await getPublishedArticles();
const crumbs = [{ label: '首页', href: '/' }, { label: '常见问题' }];

/** 通用问题（不依赖文章） */
const generalFaqs = [
  {
    question: 'Cloudways 到底是什么？和普通虚拟主机有什么不同？',
    answer:
      'Cloudways 是托管云主机平台。底层是一台你独享的云服务器（来自 DigitalOcean、AWS、Google Cloud、Linode 或 Vultr），但操作系统层的事情（缓存、备份、SSL、扩容、监控）由平台自动化处理。它介于纯 VPS（全部自己管）和全托管 WordPress（厂商全包）之间，你只需管理应用层。',
  },
  {
    question: 'Cloudways 支持哪些底层云厂商？',
    answer:
      '目前支持 DigitalOcean、Amazon AWS、Google Cloud Platform、Linode (Akamai) 和 Vultr 五家。你可以在控制面板里自由选择，不同厂商决定机房位置与价格基线，托管能力完全一致。',
  },
  {
    question: '最便宜多少钱一个月？',
    answer:
      '最低配置为 1GB 内存 / 1 vCPU / 25GB SSD，搭配 DigitalOcean、Linode 或 Vultr 底层均为 14 美元/月，按小时计费约 0.021 美元/小时。注意 14 美元是月费估算值，实际按使用小时数累计。',
  },
  {
    question: '有免费试用吗？需要信用卡吗？',
    answer:
      '有，且不需要信用卡。可以直接部署一台服务器完整体验面板功能，包括 Breeze 缓存、自动备份、实时监控与 24/7 客服。试用期结束再决定是否付费，不满意直接删除即可。',
  },
  {
    question: '按小时计费是怎么算的？',
    answer:
      '控制台显示月费估算，实际按小时累计、月底结算。月中删除服务器只需支付已使用小时数的费用，不会扣满整月。这是做对比测试和临时部署时最有价值的一点。',
  },
  {
    question: '支持 WordPress 和 WooCommerce 吗？',
    answer:
      '支持，且是官方一键部署的选项。此外还支持 Magento 2、Laravel、PrestaShop 与 PHP 自定义应用。不支持 Windows / .NET 环境，也不能一键部署 Node.js 或 Go 服务（可通过 SSH 自行安装）。',
  },
  {
    question: '一台服务器能放几个网站？',
    answer:
      'Cloudways 的模型是「一台服务器对应一个应用」。要在同一台服务器跑多个站，需要使用 WordPress Multisite 功能，或在面板里为同一服务器添加多个应用共享资源。生产环境慎用共享模式，因为任一站点流量暴涨都会影响其它站点。',
  },
  {
    question: '服务器删除后数据还能恢复吗？',
    answer:
      '不能。删除服务器会同时销毁其上的所有数据与备份。最佳实践是定期把备份导出到本地或第三方对象存储（如 S3、Backblaze B2），不要把唯一的数据副本放在同一台服务器上。',
  },
  {
    question: '有免费 SSL 和自动备份吗？',
    answer:
      '有。Cloudways 自动签发并续期 Let’s Encrypt 证书，也支持上传自定义证书。备份默认提供定期自动备份，可加购提升到每 1 小时一次，所有备份支持一键回滚。',
  },
  {
    question: '客服怎么联系？响应快吗？',
    answer:
      '提供 24/7 在线聊天（面板右下角）与工单系统。实测首次响应通常在 1–3 分钟内，常见问题一线即可解决；涉及底层机房网络等复杂故障会转由工程师跟进，等待时间较长。提问题时附上具体错误信息、时间点和已尝试的步骤能显著缩短解决时间。',
  },
];

/** 汇总文章内 FAQ，按分类分组 */
const articleFaqs = CATEGORY_KEYS.map((key) => ({
  key,
  label: CATEGORIES[key].label,
  color: CATEGORIES[key].color,
  faqs: articles
    .filter((a) => a.data.category === key)
    .flatMap((a) => a.data.faqs)
    .slice(0, 8),
})).filter((group) => group.faqs.length > 0);

const allFaqs = [...generalFaqs, ...articleFaqs.flatMap((g) => g.faqs)];
---

<BaseLayout
  title="Cloudways 常见问题解答"
  description={`Cloudways 高频问题汇总：计费方式、免费试用、退款政策、扩容降配、应用支持范围与客服联系方式，共 ${allFaqs.length} 个问答。`}
  path="/faq/"
  keywords={['Cloudways 常见问题', 'Cloudways FAQ', 'Cloudways 退款', 'Cloudways 计费']}
  schemas={[breadcrumbSchema(crumbs), faqSchema(allFaqs)]}
  width="default"
>
  <Breadcrumbs items={crumbs} />

  <header class="mt-6 max-w-3xl">
    <span class="chip border border-brand-200 bg-brand-50 text-brand-700">
      <Icon name="info" size={13} />
      {allFaqs.length} 个问答
    </span>
    <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-[2.4rem]">常见问题</h1>
    <p class="mt-4 text-[17px] leading-relaxed text-ink-500">
      把新手最常问的问题一次讲清。如果这里没有你要的答案，
      可以在<strong>文章详情页底部的问答区</strong>找到更细的专题解答。
    </p>
  </header>

  <!-- 通用问题 -->
  <FaqSection faqs={generalFaqs} title="基础与计费" class="mt-10" />

  <!-- 分类专题 -->
  {
    articleFaqs.map((group) => (
      <section class="mt-12" aria-labelledby={`faq-${group.key}`}>
        <h2 id={`faq-${group.key}`} class="flex items-center gap-2.5 text-xl font-bold">
          <span
            class="h-2.5 w-2.5 rounded-full"
            style={`background:${group.color}`}
            aria-hidden="true"
          />
          {group.label}相关
          <a
            href={`/categories/${group.key}/`}
            class="ml-1 text-[13px] font-medium text-brand-600 hover:underline"
          >
            查看全部
          </a>
        </h2>
        <div class="mt-5 divide-y divide-line overflow-hidden rounded-2xl border border-line bg-white">
          {group.faqs.map((faq) => (
            <details class="group px-5 py-4" name={`faq-${group.key}`}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[15px] font-semibold text-ink-900">
                <span>{faq.question}</span>
                <span class="grid h-6 w-6 shrink-0 place-items-center rounded-md bg-surface-2 text-ink-500 transition-transform group-open:rotate-45">
                  <Icon name="plus" size={14} />
                </span>
              </summary>
              <div class="mt-3 pr-8 text-[14.5px] leading-relaxed text-ink-600">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </section>
    ))
  }

  <section class="mt-14 rounded-2xl border border-brand-200 bg-brand-50/60 p-6 sm:p-8">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-xl font-bold text-ink-900">还有疑问？直接问官方客服</h2>
        <p class="mt-2 max-w-xl text-[14.5px] leading-relaxed text-ink-600">
          Cloudways 提供 24/7 在线聊天，首次响应通常在 1–3 分钟内。
          注册后即可在面板右下角发起对话，售前问题也可以直接问。
        </p>
      </div>
      <AffiliateButton label="注册并联系客服" variant="cta" size="lg" class="shrink-0" />
    </div>
  </section>
</BaseLayout>
